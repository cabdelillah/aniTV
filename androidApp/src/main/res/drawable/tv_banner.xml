<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180dp Android TV launcher banner. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:endColor="#FF7B2FF7" android:startColor="#FFFF4D6D" />
        </shape>
    </item>
    <item android:width="180dp" android:height="180dp" android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
